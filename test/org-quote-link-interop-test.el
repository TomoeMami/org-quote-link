;;; Commentary:

;; Optional interoperability tests for org-quote-link.
;;
;; These are NOT part of the package dependencies and are not run by
;; `make test'.  They check that the generated blocks happen to be
;; usable with org-transclusion-blocks when that package is installed.
;; They need a recent Emacs (>= 29.1) with `org-transclusion' and
;; `org-transclusion-blocks' on the load path, for example:
;;
;;   emacs -Q -batch -L . \
;;     -L ~/path/to/org-transclusion -L ~/path/to/org-transclusion-blocks \
;;     -l test/org-quote-link-interop-test.el \
;;     -f ert-run-tests-batch-and-exit
;;
;; The tests are skipped automatically when org-transclusion-blocks is
;; not available (e.g. with the Org bundled in Emacs 27).

;;; Code:

;; Prefer the source so a byte-compiled file from another Emacs
;; version cannot shadow it during development.
(setq load-prefer-newer t)

(require 'ert)
(require 'org)
(require 'org-quote-link)

(defmacro org-quote-link-interop-test--with-dir (&rest body)
  "Run BODY with `dir' bound to a fresh temporary directory."
  (declare (indent 0) (debug t))
  `(let ((dir (make-temp-file "org-quote-link-interop" t)))
     (unwind-protect
         (progn ,@body)
       (let ((truename (file-truename dir)))
         (dolist (buffer (buffer-list))
           (let ((file (buffer-file-name buffer)))
             (when (and file
                        (string-prefix-p truename (file-truename file)))
               (with-current-buffer buffer
                 (set-buffer-modified-p nil))
               (kill-buffer buffer)))))
       (delete-directory dir t))))

(defun org-quote-link-interop-test--write (dir name content)
  "Write CONTENT to NAME inside DIR and return the file name."
  (let ((file (expand-file-name name dir)))
    (with-temp-file file (insert content))
    file))

(defun org-quote-link-interop-test--visit (dir name)
  "Visit NAME inside DIR and return its buffer."
  (find-file-noselect (expand-file-name name dir)))

(defun org-quote-link-interop-test--convert (buffer needle)
  "Quote the link at NEEDLE in BUFFER and return the buffer text."
  (with-current-buffer buffer
    (goto-char (point-min))
    (unless (search-forward needle nil t)
      (error "Text %S not found" needle))
    (goto-char (match-beginning 0))
    (org-quote-link-at-point)
    (buffer-string)))

(defun org-quote-link-interop-test--skip (reason)
  "Skip the current test because org-transclusion-blocks is unavailable."
  (if (fboundp 'ert-skip)
      (ert-skip reason)
    (error "SKIPPED: %s" reason)))

(defmacro org-quote-link-interop-test--with-blocks (&rest body)
  "Run BODY only when org-transclusion-blocks can be loaded."
  (declare (indent 0) (debug t))
  `(condition-case nil
       (progn (require 'org-transclusion)
              (require 'org-transclusion-blocks)
              ,@body)
     (file-missing
      (org-quote-link-interop-test--skip "org-transclusion-blocks is not available"))))

;;; Generated blocks are valid org-transclusion-blocks blocks

(ert-deftest org-quote-link-interop-blocks-add-accepts-generated-block ()
  "A block generated by `org-quote-link-at-point' can be refreshed by blocks-add."
  (org-quote-link-interop-test--with-blocks
    (org-quote-link-interop-test--with-dir
      (org-quote-link-interop-test--write
       dir "target.org" "* Target Heading\nbody one\n")
      (org-quote-link-interop-test--write
       dir "main.org" "[[file:target.org::*Target Heading]]\n")
      (let ((buffer (org-quote-link-interop-test--visit dir "main.org")))
        (let ((result (org-quote-link-interop-test--convert buffer "[[file:")))
          (should (string-match-p (regexp-quote ",* Target Heading\nbody one\n")
                                  result)))
        ;; The command leaves point at the beginning of the block, which is
        ;; where `org-transclusion-blocks-add' expects it.
        (with-current-buffer buffer
          (goto-char (point-min))
          (should (org-transclusion-blocks-add))
          (should (string-match-p (regexp-quote ",* Target Heading\nbody one")
                                  (buffer-string))))
        ;; Change the source, refresh through blocks-add.
        (let ((target-buffer (org-quote-link-interop-test--visit dir "target.org")))
          (with-current-buffer target-buffer
            (goto-char (point-min))
            (search-forward "body one")
            (replace-match "body two" t t)))
        (with-current-buffer buffer
          (goto-char (point-min))
          (search-forward "#+HEADER")
          (should (org-transclusion-blocks-add))
          (let ((text (buffer-string)))
            (should (string-match-p (regexp-quote ",* Target Heading\nbody two") text))
            (should-not (string-match-p (regexp-quote "body one") text))))))))

(ert-deftest org-quote-link-interop-blocks-add-accepts-empty-block ()
  "A hand-written empty quote block with a HEADER line is accepted."
  (org-quote-link-interop-test--with-blocks
    (org-quote-link-interop-test--with-dir
      (org-quote-link-interop-test--write
       dir "target.org" "* Target Heading\nbody\n")
      (org-quote-link-interop-test--write
       dir "main.org"
       (concat "#+HEADER: :transclude [[file:target.org::*Target Heading]]\n"
               "#+begin_quote\n"
               "#+end_quote\n"))
      (let ((buffer (org-quote-link-interop-test--visit dir "main.org")))
        (with-current-buffer buffer
          (goto-char (point-min))
          (should (org-transclusion-blocks-add))
          (should (string-match-p (regexp-quote ",* Target Heading\nbody")
                                  (buffer-string))))))))

;;; org-store-link output round trips

(ert-deftest org-quote-link-interop-accepts-org-store-link-output ()
  "Every link `org-store-link' produces in an Org buffer can be quoted."
  (org-quote-link-interop-test--with-blocks
    (org-quote-link-interop-test--with-dir
      (org-quote-link-interop-test--write
       dir "target.org"
       (concat "* Heading A\nbody A\n\n"
               "* Heading B\n:PROPERTIES:\n:CUSTOM_ID: cid-b\n:END:\nbody B\n\n"
               "<<tgt>>\n\n"
               "#+name: named-src\n#+begin_src elisp\n(+ 1 2)\n#+end_src\n"))
      (let ((target-buffer (org-quote-link-interop-test--visit dir "target.org"))
            (links nil))
        (dolist (needle '("* Heading A" "* Heading B" "<<tgt>>" "named-src"))
          (with-current-buffer target-buffer
            (goto-char (point-min))
            (search-forward needle)
            (goto-char (match-beginning 0))
            (let ((link (org-store-link nil nil)))
              (should (stringp link))
              (push link links))))
        (dolist (link links)
          (let* ((main (org-quote-link-interop-test--write
                        dir "main.org" (concat link "\n")))
                 (buffer (find-file-noselect main)))
            (let ((result (org-quote-link-interop-test--convert buffer "[[file:")))
              (should (string-match-p
                       (concat "^#\\+HEADER: :transclude "
                               (regexp-quote link) "$")
                       result))
              (should (string-match-p "^#\\+begin_quote$" result))
              (should (string-match-p "^#\\+end_quote$" result)))
            (kill-buffer buffer)))))))

;;; denote

(ert-deftest org-quote-link-interop-denote-link ()
  "The default handler quotes denote links, with heading or CUSTOM_ID search."
  (org-quote-link-interop-test--with-blocks
    (if (not (require 'denote nil t))
        (org-quote-link-interop-test--skip "denote is not available")
      (org-quote-link-interop-test--with-dir
        (let ((denote-directory (expand-file-name "notes" dir)))
          (make-directory denote-directory t)
          (org-quote-link-interop-test--write
           denote-directory "20240101T120000--test-note__tag.org"
           (concat "* Note Heading\n:PROPERTIES:\n:CUSTOM_ID: abc123\n:END:\n"
                   "note body\n"))
          (let ((index 0))
            (dolist (link '("[[denote:20240101T120000::*Note Heading]]"
                            "[[denote:20240101T120000::#abc123]]"))
              (setq index (1+ index))
              (let* ((name (format "main-%d.org" index))
                     (_ (org-quote-link-interop-test--write
                         dir name (concat link "\n")))
                     (buffer (org-quote-link-interop-test--visit dir name))
                     (result (org-quote-link-interop-test--convert
                              buffer "[[denote:")))
              (should (string-match-p
                       (concat "^#\\+HEADER: :transclude " (regexp-quote link) "$")
                       result))
                (should (string-match-p (regexp-quote ",* Note Heading\nnote body\n")
                                        result))))))))))


;;; org-id links with a search option (Org >= 9.7)

(ert-deftest org-quote-link-interop-id-link-with-search ()
  "An id:UUID::*heading link is resolved to the child heading."
  (if (version< org-version "9.7")
      (org-quote-link-interop-test--skip
       "id: links with a search option need Org >= 9.7")
    (org-quote-link-interop-test--with-dir
      (let* ((target (org-quote-link-interop-test--write
                      dir "target.org"
                      (concat "* Parent\n:PROPERTIES:\n:ID: parent-id\n:END:\n"
                              "parent body\n\n** Child\nchild body\n")))
             (org-id-locations-file (expand-file-name ".org-id-locations" dir)))
        (org-id-add-location "parent-id" target)
        (org-quote-link-interop-test--write
         dir "main.org" "[[id:parent-id::*Child]]\n")
        (let* ((buffer (org-quote-link-interop-test--visit dir "main.org"))
               (result (org-quote-link-interop-test--convert buffer "[[id:")))
          (should (string-match-p
                   (regexp-quote "#+HEADER: :transclude [[id:parent-id::*Child]]")
                   result))
          (should (string-match-p (regexp-quote ",** Child\nchild body\n")
                                  result)))))))

;;; Links with a description (what `org-store-link' usually produces)

(ert-deftest org-quote-link-interop-blocks-add-with-description ()
  "A store-link style link with a description is accepted by blocks-add."
  (org-quote-link-interop-test--with-blocks
    (org-quote-link-interop-test--with-dir
      (org-quote-link-interop-test--write
       dir "target.org" "* Target Heading\nbody\n")
      (let* ((target-buffer
              (org-quote-link-interop-test--visit dir "target.org"))
             (link (with-current-buffer target-buffer
                     (goto-char (point-min))
                     (org-store-link nil nil))))
        (should (string-match-p "\\]\\[" link))
        (org-quote-link-interop-test--write
         dir "main.org" (concat link "\n"))
        (let ((buffer (org-quote-link-interop-test--visit dir "main.org")))
          (let ((result (org-quote-link-interop-test--convert buffer "[[file:")))
            (should (string-match-p (regexp-quote link) result)))
          (with-current-buffer buffer
            (goto-char (point-min))
            (should (org-transclusion-blocks-add))
            (should (string-match-p (regexp-quote ",* Target Heading\nbody")
                                    (buffer-string)))))))))


(ert-deftest org-quote-link-interop-denote-refresh ()
  "A block built from a denote link can be refreshed by org-quote-link."
  (org-quote-link-interop-test--with-blocks
    (if (not (require 'denote nil t))
        (org-quote-link-interop-test--skip "denote is not available")
      (org-quote-link-interop-test--with-dir
        (let* ((denote-directory (expand-file-name "notes" dir))
               (note-file (progn
                            (make-directory denote-directory t)
                            (org-quote-link-interop-test--write
                             denote-directory "20240102T120000--note__tag.org"
                             "* Note Heading\nold note body\n"))))
          (org-quote-link-interop-test--write
           dir "main.org" "[[denote:20240102T120000::*Note Heading]]\n")
          (let ((buffer (org-quote-link-interop-test--visit dir "main.org"))
                (note-buffer (find-file-noselect note-file)))
            (org-quote-link-interop-test--convert buffer "[[denote:")
            (with-current-buffer note-buffer
              (goto-char (point-min))
              (search-forward "old note body")
              (replace-match "new note body" t t))
            (with-current-buffer buffer
              (goto-char (point-min))
              (search-forward "#+HEADER")
              (org-quote-link-refresh)
              (should (string-match-p (regexp-quote ",* Note Heading\nnew note body")
                                      (buffer-string)))
              (should-not (string-match-p (regexp-quote "old note body")
                                          (buffer-string))))))))))


(ert-deftest org-quote-link-interop-blocks-add-non-org-escape ()
  "Non-Org escaping stays compatible with `org-transclusion-blocks-add'."
  (org-quote-link-interop-test--with-blocks
    (org-quote-link-interop-test--with-dir
      (org-quote-link-interop-test--write
       dir "star.txt" "* star line\nsecond\n")
      (org-quote-link-interop-test--write
       dir "main.org" "[[file:star.txt]]\n")
      (let* ((org-quote-link-escape-non-org-syntax t)
             (buffer (org-quote-link-interop-test--visit dir "main.org"))
             (result (org-quote-link-interop-test--convert buffer "[[file:")))
        (should (string-match-p
                 (regexp-quote "#+HEADER: :transclude-escape-org t")
                 result))
        (should (string-match-p (regexp-quote ",* star line") result))
        ;; blocks-add must make the same escaping decision and must not be
        ;; left with a corrupted block.
        (with-current-buffer buffer
          (goto-char (point-min))
          (should (org-transclusion-blocks-add))
          (should (string-match-p (regexp-quote ",* star line")
                                  (buffer-string)))
          (should (string-match-p
                   (concat "^" (regexp-quote "#+end_quote") "$")
                   (buffer-string))))))))

(provide 'org-quote-link-interop-test)
;;; org-quote-link-interop-test.el ends here
